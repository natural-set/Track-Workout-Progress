{
    "name": "shield-wall/easy-php-setup",
    "description": "It is a simple way to make php run locally",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "authors": [
        {
            "name": "Erison Silva"
        }
    ],
    "require": {
        "symfony/routing": "^6.3",
        "symfony/http-foundation": "^6.3",
        "twig/twig": "^3.0",
        "symfony/asset": "^6.4",
        "symfony/console": "^7.2",
        "symfony/framework-bundle": "^7.2",
        "doctrine/doctrine-bundle": "^2.14",
        "doctrine/orm": "^3.3",
        "doctrine/dbal": "^3.9",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "symfony/yaml": "^7.2",
        "symfony/runtime": "^7.2",
        "symfony/flex": "^2.5",
        "symfony/dotenv": "^7.2"
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.62",
        "doctrine/doctrine-fixtures-bundle": "^4.1"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "symfony/flex": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
